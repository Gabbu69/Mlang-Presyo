          "sql": "CREATE TABLE IF NOT EXISTS \"stores\" (\"id\" TEXT PRIMARY KEY NOT NULL, \"name\" TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 200), \"barangay_text\" TEXT, \"landmark\" TEXT, \"archived\" INTEGER NOT NULL CHECK (archived IN (0, 1)), \"created_at_utc\" TEXT NOT NULL, \"updated_at_utc\" TEXT NOT NULL, \"area_text\" TEXT CHECK (area_text IS NULL OR(typeof(area_text) = 'text' AND length(area_text) BETWEEN 1 AND 200)), \"latitude_e6\" INTEGER CHECK (latitude_e6 IS NULL OR(typeof(latitude_e6) = 'integer' AND latitude_e6 BETWEEN -90000000 AND 90000000)), \"longitude_e6\" INTEGER CHECK (longitude_e6 IS NULL OR(typeof(longitude_e6) = 'integer' AND longitude_e6 BETWEEN -180000000 AND 180000000)), \"accuracy_m\" INTEGER CHECK (accuracy_m IS NULL OR(typeof(accuracy_m) = 'integer' AND accuracy_m BETWEEN 1 AND 100000)), \"location_captured_at_utc\" TEXT CHECK ((latitude_e6 IS NULL AND longitude_e6 IS NULL AND accuracy_m IS NULL AND location_captured_at_utc IS NULL)OR(latitude_e6 IS NOT NULL AND longitude_e6 IS NOT NULL AND accuracy_m IS NOT NULL AND typeof(location_captured_at_utc) = 'text')));"
        }
      ]
