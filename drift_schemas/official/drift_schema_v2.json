      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"price_records\" (\"id\" TEXT PRIMARY KEY NOT NULL, \"product_id\" TEXT NOT NULL REFERENCES products(id)ON DELETE RESTRICT, \"store_id\" TEXT NOT NULL REFERENCES stores(id)ON DELETE RESTRICT, \"quoted_centavos\" INTEGER NOT NULL CHECK (typeof(quoted_centavos) = 'integer' AND quoted_centavos BETWEEN 1 AND 100000000), \"offered_quantity_base\" INTEGER NOT NULL CHECK (typeof(offered_quantity_base) = 'integer' AND offered_quantity_base BETWEEN 1 AND 1000000), \"selling_mode\" TEXT NOT NULL CHECK (selling_mode IN ('loose', 'packaged')), \"offer_type\" TEXT NOT NULL CHECK (offer_type IN ('regular', 'promotional', 'conditional')), \"source_type\" TEXT NOT NULL CHECK (source_type IN ('observed', 'purchase', 'seller_quote')), \"observed_on\" TEXT NOT NULL, \"notes\" TEXT NOT NULL, \"created_at_utc\" TEXT NOT NULL, \"updated_at_utc\" TEXT NOT NULL);"
