        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT PRIMARY KEY NOT NULL, \"name\" TEXT NOT NULL CHECK (length(name) BETWEEN 1 AND 200), \"brand\" TEXT NOT NULL, \"variant_grade\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"quantity_kind\" TEXT NOT NULL CHECK (quantity_kind IN ('mass', 'volume', 'count')), \"archived\" INTEGER NOT NULL CHECK (archived IN (0, 1)), \"created_at_utc\" TEXT NOT NULL, \"updated_at_utc\" TEXT NOT NULL);"
